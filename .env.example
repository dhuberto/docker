# =============================================================================
# .env.example — template de configuração
# =============================================================================
# Copie para .env (cp .env.example .env) e ajuste os valores antes de subir.
# O arquivo .env NÃO deve ser versionado (está no .gitignore).
#
# DB_HOST  → nome do serviço do Postgres no compose.yml
# DB_USER  → usuário criado no primeiro boot do Postgres
# DB_PASSWORD → senha do usuário
# DB_NAME  → banco criado no primeiro boot
# DB_PORT  → porta interna do Postgres
# =============================================================================
DB_HOST=postgres-go
DB_USER=appuser
DB_PASSWORD=mudar123
DB_NAME=appdb
DB_PORT=5432
